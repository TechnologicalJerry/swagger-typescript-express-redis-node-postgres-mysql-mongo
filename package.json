{
  "name": "redis-learning-backend",
  "version": "1.0.0",
  "description": "Learning-focused backend demonstrating Redis concepts across multiple data stores",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate --config prisma/postgres/prisma.config.ts && prisma generate --config prisma/mysql/prisma.config.ts",
    "prisma:generate:postgres": "prisma generate --config prisma/postgres/prisma.config.ts",
    "prisma:generate:mysql": "prisma generate --config prisma/mysql/prisma.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.6.0",
    "mariadb": "^3.4.5",
    "mongoose": "^9.1.2",
    "pg": "^8.16.3",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.0",
    "prisma": "7.10.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.25.0",
    "vitest": "^3.0.0"
  }
}

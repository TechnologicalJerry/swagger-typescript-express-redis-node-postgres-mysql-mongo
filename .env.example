# Application
NODE_ENV=development
PORT=3000
CORS_ORIGIN=*
SHUTDOWN_TIMEOUT_MS=10000
BCRYPT_WORK_FACTOR=10

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=redis_learning_pg
POSTGRES_PORT=5432
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/redis_learning_pg?schema=public

# MySQL
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_USER=mysqluser
MYSQL_PASSWORD=mysqlpassword
MYSQL_DATABASE=redis_learning_mysql
MYSQL_PORT=3306
MYSQL_URL=mysql://mysqluser:mysqlpassword@localhost:3306/redis_learning_mysql

# MongoDB
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=mongopassword
MONGO_DATABASE=redis_learning_mongo
MONGO_PORT=27017
MONGO_URL=mongodb://root:mongopassword@localhost:27017/redis_learning_mongo?authSource=admin

# Redis
REDIS_PASSWORD=redispassword
REDIS_PORT=6379
REDIS_URL=redis://:redispassword@localhost:6379/0

# Mailpit (local testing)
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025

# JWT and Session Configuration
JWT_ACCESS_SECRET=dev_jwt_access_secret_key_at_least_32_characters_long
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_key_at_least_32_characters_long
JWT_ISSUER=redis-learning-backend
JWT_AUDIENCE=redis-learning-api
JWT_ACCESS_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_SECONDS=604800
MAX_ACTIVE_SESSIONS_PER_USER=2

# OTP Configuration
OTP_EXPIRATION_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=3
OTP_COOLDOWN_SECONDS=60
OTP_SECRET=dev_otp_hmac_secret_key_at_least_32_characters_long

# Mailer / SMTP Configuration (defaults to Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
EMAIL_FROM=noreply@redis-learning.local

# Rate Limiting Configuration
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_MAX_REQUESTS=10
RATE_LIMIT_OTP_WINDOW_SECONDS=300
RATE_LIMIT_OTP_MAX_REQUESTS=5

# Product Cache and Cache-Stampede Protection
PRODUCT_CACHE_TTL_SECONDS=300
PRODUCT_LIST_CACHE_TTL_SECONDS=60
PRODUCT_CACHE_LOCK_TTL_MS=2000
PRODUCT_CACHE_LOCK_TIMEOUT_MS=500

# Product Analytics, Periodic Aggregation, and Trending
PRODUCT_VIEW_AGGREGATION_INTERVAL_MS=60000
PRODUCT_VIEW_BATCH_SIZE=100
VIEWER_HMAC_SECRET=dev_viewer_hmac_secret_key_at_least_32_characters_long
TRENDING_DEFAULT_LIMIT=10

# Inventory Reservations and Distributed Locks
RESERVATION_DEFAULT_TTL_SECONDS=600
RESERVATION_MAX_TTL_SECONDS=3600
RESERVATION_LOCK_TTL_MS=5000
RESERVATION_RECOVERY_INTERVAL_MS=30000

# Redis Streams and Audit Event Processing
REDIS_STREAM_DOMAIN_EVENTS=stream:domain-events
REDIS_STREAM_DEAD_LETTER=stream:dead-letter:domain-events
REDIS_STREAM_CONSUMER_GROUP=audit-log-workers
REDIS_STREAM_CONSUMER_NAME=audit-worker-1
REDIS_STREAM_BATCH_SIZE=10
REDIS_STREAM_BLOCK_MS=2000
REDIS_STREAM_MAX_RETRIES=3
REDIS_STREAM_CLAIM_MIN_IDLE_MS=60000
REDIS_STREAM_MAX_LEN=10000
OUTBOX_POLL_INTERVAL_MS=10000





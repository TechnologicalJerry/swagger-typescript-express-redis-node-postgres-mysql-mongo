# Application
NODE_ENV=development
PORT=3000
CORS_ORIGIN=*
SHUTDOWN_TIMEOUT_MS=10000
BCRYPT_WORK_FACTOR=10

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=redis_learning_pg
POSTGRES_PORT=5432
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/redis_learning_pg?schema=public

# MySQL
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_USER=mysqluser
MYSQL_PASSWORD=mysqlpassword
MYSQL_DATABASE=redis_learning_mysql
MYSQL_PORT=3306
MYSQL_URL=mysql://mysqluser:mysqlpassword@localhost:3306/redis_learning_mysql

# MongoDB
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=mongopassword
MONGO_DATABASE=redis_learning_mongo
MONGO_PORT=27017
MONGO_URL=mongodb://root:mongopassword@localhost:27017/redis_learning_mongo?authSource=admin

# Redis
REDIS_PASSWORD=redispassword
REDIS_PORT=6379
REDIS_URL=redis://:redispassword@localhost:6379/0

# Mailpit (local testing)
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025

# JWT and Session Configuration
JWT_ACCESS_SECRET=dev_jwt_access_secret_key_at_least_32_characters_long
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_key_at_least_32_characters_long
JWT_ISSUER=redis-learning-backend
JWT_AUDIENCE=redis-learning-api
JWT_ACCESS_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_SECONDS=604800
MAX_ACTIVE_SESSIONS_PER_USER=2
